    <string name="app_name">Shizuku 설치기</string>
    <string name="install_with_label">Shizuku로 설치</string>
    <string name="tagline">Shizuku(adb/root)로 APK를 강제 설치합니다</string>

    <string name="state_not_running">Shizuku가 실행되고 있지 않음</string>
    <string name="state_too_old">Shizuku 버전이 너무 낮음</string>
